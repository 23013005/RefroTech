<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/scrollRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@drawable/bg_lobby_pemimpin">

    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="20dp">

        <!-- Header logo -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:layout_marginTop="0dp">

            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/refro_logo2"
                android:contentDescription="@string/app_name" />
        </LinearLayout>

        <!-- Title -->
        <TextView
            android:id="@+id/reportTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Laporan Pekerjaan"
            android:textSize="22sp"
            android:fontFamily="@font/inter_bold"
            android:textColor="@color/black"
            android:gravity="center"
            android:layout_marginTop="16dp" />

        <!-- No report / loading placeholder -->
        <LinearLayout
            android:id="@+id/noReportContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="12dp"
            android:padding="12dp"
            android:background="@drawable/input_box_login">

            <TextView
                android:id="@+id/tvNoReport"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="(No report / loading...)"
                android:textColor="@color/black"
                android:padding="6dp" />
        </LinearLayout>

        <!-- Customer block -->
        <LinearLayout
            android:id="@+id/customerBlock"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="12dp"
            android:padding="12dp"
            android:background="@drawable/input_box_login">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Customer"
                android:textStyle="bold"
                android:textColor="@color/black" />

            <TextView
                android:id="@+id/tvReportCustomerName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Name"
                android:textColor="@color/black" />

            <TextView
                android:id="@+id/tvReportPhone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Phone"
                android:textColor="@color/black" />

            <TextView
                android:id="@+id/tvReportAddress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Address"
                android:textColor="@color/black" />
        </LinearLayout>

        <!-- Date & Time row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="12dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:padding="12dp"
                android:background="@drawable/input_box_login">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Tanggal"
                    android:textStyle="bold"
                    android:textColor="@color/black" />

                <TextView
                    android:id="@+id/tvReportDate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="YYYY-MM-DD"
                    android:textColor="@color/black" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:padding="12dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/input_box_login">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Jam Mulai"
                    android:textStyle="bold"
                    android:textColor="@color/black" />

                <TextView
                    android:id="@+id/tvReportTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="HH:mm"
                    android:textColor="@color/black" />
            </LinearLayout>
        </LinearLayout>



        <!-- Technicians block -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="12dp"
            android:padding="12dp"
            android:background="@drawable/input_box_login">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Teknisi"
                android:textStyle="bold"
                android:textColor="@color/black" />

            <TextView
                android:id="@+id/tvReportTechnicians"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Technician names"
                android:textColor="@color/black" />

            <TextView
                android:id="@+id/tvReportTechnicianIds"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Technician IDs"
                android:textColor="@color/black" />
        </LinearLayout>

        <!-- Units label -->
        <TextView
            android:id="@+id/tvReportUnitsLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Units"
            android:textStyle="bold"
            android:layout_marginTop="12dp"
            android:textColor="@color/black" />

        <!-- Units Recycler -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerReportUnits"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:nestedScrollingEnabled="false"
            android:layout_marginTop="8dp" />

        <!-- Documentation label -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Documentation"
            android:textStyle="bold"
            android:layout_marginTop="12dp"
            android:textColor="@color/black" />

        <!-- Documentation recycler -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerReportDocs"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:nestedScrollingEnabled="false"
            android:layout_marginTop="8dp" />

        <!-- Spacer -->
        <View
            android:layout_width="match_parent"
            android:layout_height="40dp" />

    </LinearLayout>
</ScrollView>
