<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/inAppNotifContainer"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/in_app_notif_bg"
    android:orientation="vertical"
    android:elevation="10dp"
    android:padding="16dp"
    android:visibility="gone">   <!-- VERY IMPORTANT -->

    <TextView
        android:id="@+id/notifTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Notification Title"
        android:textStyle="bold"
        android:textColor="@android:color/black"
        android:textSize="16sp" />

    <TextView
        android:id="@+id/notifMessage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Notification message here"
        android:textColor="@android:color/black"
        android:layout_marginTop="4dp"
        android:textSize="14sp" />
</LinearLayout>
